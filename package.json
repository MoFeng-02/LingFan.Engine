{
  "name": "lingfan-engine",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "description": "灵泛叙事引擎：框架无关核心 + 预设适配器 + 参考宿主 + 脚手架",
  "scripts": {
    "dev": "pnpm --filter @lingfan-engine/playground dev",
    "build": "pnpm --filter @lingfan-engine/playground build",
    "preview": "pnpm --filter @lingfan-engine/playground preview",
    "tauri": "pnpm --filter @lingfan-engine/playground exec tauri",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "audit:runtime": "node scripts/audit-runtime/index.mjs",
    "publish:check": "node scripts/publish-check.mjs",
    "publish:push": "node scripts/publish-tarballs.mjs",
    "version:check": "node scripts/version-check.mjs",
    "release": "node scripts/release/main.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "typecheck": "vue-tsc --noEmit",
    "editor": "pnpm --filter @lingfan-engine/editor-app dev",
    "editor:host": "pnpm --filter @lingfan-engine/editor-app host",
    "editor:dev": "node scripts/editor-dev.mjs"
  },
  "devDependencies": {
    "@lingfan-engine/adapters": "workspace:*",
    "@lingfan-engine/core": "workspace:*",
    "@lingfan-engine/stories-build": "workspace:*",
    "@lingfan-engine/ui": "workspace:*",
    "@types/node": "^26.6.3",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.0.16",
    "vitest": "^5.0.1",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.5"
  },
  "dependencies": {
    "@lingfan-engine/editor": "workspace:*",
    "zod": "^4.6.5"
  }
}
