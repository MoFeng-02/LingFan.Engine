---
/**
 * Footer.astro · 覆盖 Starlight 内置页脚（三段式）
 *
 * 三段：
 *   ① 品牌段 —— 文字标识 + 一句话定位（对外站点的自我说明）
 *   ② 导航段 —— 三组静态链接（按界面规范 的顶级分组组织）
 *   ③ 元信息段 —— 保留 Starlight 的 EditLink / LastUpdated / Pagination，
 *      并在其下追加版权行
 *
 * 契约要点（改这个文件前务必读）：
 *   · EditLink / LastUpdated / Pagination **必须从 `virtual:starlight/components/*`
 *     导入**，不能从 `@astrojs/starlight/components` 导入（后者不导出它们）。
 *   · 本项目暂未开启 editLink / lastUpdated，因此前两者当前渲染为空；
 *     保留导入是为了将来开启配置时页脚自动生效，不是死代码。
 *   · Pagination 是页内上下页导航，必须在 <footer> 内、且在版权行之前。
 *   · columns 里的 href 写根绝对路径即可，渲染时统一经 withLocale() 补
 *     「当前页 locale 前缀 + 部署基路径」：Starlight 只改写「自己生成的」链接，
 *     组件里的字面路径不改写，线上会 404。locale 段取
 *     Astro.locals.starlightRoute?.locale（root locale 页面为 undefined），
 *     因此 zh 页页脚链 zh 页、en 页页脚链 /en/ 页（未翻译页由 Starlight 的
 *     回退机制在 /en/ 路径下发中文内容）。品牌段 logo 是语言无关资源，
 *     仍走 withBase()。
 *   · 文案随 locale 双语：locale === 'en' 时标题/链接名/品牌段/版权行走英文，
 *     其余（root）走中文。双语对照行（品牌段第二行）两侧互为镜像。
 */
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import { withBase, withLocale } from '../utils/url';

const year = new Date().getFullYear();
const locale = Astro.locals.starlightRoute?.locale;
const en = locale === 'en';

const columns = [
	{
		heading: en ? 'Getting started' : '开始上手',
		links: [
			{ label: en ? 'Introduction' : '简介', href: '/introduction/' },
			{ label: en ? 'Quick Start' : '快速开始', href: '/getting-started/' },
			{ label: en ? 'Project Structure' : '工程结构', href: '/project-structure/' },
		],
	},
	{
		heading: en ? 'Core concepts' : '核心概念',
		links: [
			{ label: en ? 'Story & Narrative Flow' : '故事与叙事流', href: '/concepts/story/' },
			{ label: en ? 'State & Variables' : '状态与变量', href: '/concepts/state/' },
			{ label: en ? 'Save System' : '存档系统', href: '/concepts/saves/' },
		],
	},
	{
		heading: en ? 'Reference' : '参考',
		links: [
			{ label: en ? 'Op Reference' : 'op 指令参考', href: '/reference/ops/' },
			{ label: en ? 'project.json Manifest' : 'project.json 工程清单', href: '/reference/manifest/' },
			{ label: en ? 'Resources Layout' : 'Resources 目录约定', href: '/reference/resources-layout/' },
		],
	},
];
---

<footer class="lf-footer">
	<div class="lf-footer__grid">
		<section class="lf-footer__section">
			<p class="lf-footer__brand">
				<img
					class="lf-footer__mark"
					src={withBase('/logo-mark.png')}
					alt=""
					width="32"
					height="32"
					loading="lazy"
					decoding="async"
					aria-hidden="true"
				/>
				<span class="lf-footer__brand-text">
					<span class="lf-footer__brand-name">{en ? 'LingFan Engine' : '灵泛引擎'}</span>
					<span class="lf-footer__brand-alt">{en ? '灵泛引擎' : 'LingFan Engine'}</span>
				</span>
			</p>
			<p class="lf-footer__pitch">
				{
					en
						? 'An open-source engine and project template for narrative games: one project manifest and one op vocabulary that split story, stage and platform adaptation into composable layers.'
						: '面向叙事类游戏的开源引擎与工程模板：用一份工程清单与一套 op 指令，把故事、舞台与平台适配拆成可组合的层。'
				}
			</p>
		</section>

		<div class="lf-footer__columns">
			{
				columns.map((column) => (
					<section class="lf-footer__section">
						<h2 class="lf-footer__heading">{column.heading}</h2>
						<ul class="lf-footer__list">
							{column.links.map((link) => (
								<li>
									<a class="lf-footer__link" href={withLocale(link.href, locale)}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>

		<section class="lf-footer__section">
			<h2 class="lf-footer__heading">{en ? 'About this site' : '关于本站'}</h2>
			<ul class="lf-footer__list">
				<li>
					<a class="lf-footer__link" href="https://github.com/MoFeng-02/LingFan.Engine">
						{en ? 'GitHub repository' : 'GitHub 仓库'}
					</a>
				</li>
				<li>
					<a class="lf-footer__link" href={withLocale('/reference/template-boundaries/', locale)}>
						{en ? 'Template capability boundaries' : '模板能力边界'}
					</a>
				</li>
			</ul>
		</section>
	</div>

	<div class="lf-footer__meta">
		<div class="lf-footer__meta-row">
			<EditLink />
			<LastUpdated />
		</div>
		<Pagination />
		<p class="lf-footer__copyright">
			© {year} LingFan Engine ·{' '}
			{en
				? 'Site content evolves in lockstep with the engine source; examples reflect the current version.'
				: '本站内容与引擎源码同步演进，示例以当前版本为准。'}
		</p>
	</div>
</footer>
