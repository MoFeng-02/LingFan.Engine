{
  "name": "@lingfan-engine/stories-build",
  "version": "0.1.4",
  "type": "module",
  "description": "Stories 创作链编译包：把 Stories.src 的多目录原生 TS 源编译成 Resources/Stories/** + project.json，并产出 cell 注册生成物",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./authoring": "./src/authoring.d.ts",
    "./cell": "./src/cell/index.ts",
    "./cli": "./src/cli/cli.ts",
    "./watch": "./src/pipeline/watch.ts",
    "./watch-cli": "./src/cli/watch-cli.ts"
  },
  "bin": {
    "lingfan-stories-build": "./bin/stories-build.mjs",
    "lingfan-stories-watch": "./bin/stories-watch.mjs"
  },
  "files": [
    "src",
    "bin",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "dependencies": {
    "@lingfan-engine/core": "workspace:^",
    "@lingfan-engine/editor": "workspace:^",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoFeng-02/LingFan.Engine.git",
    "directory": "packages/stories-build"
  },
  "homepage": "https://github.com/MoFeng-02/LingFan.Engine#readme",
  "bugs": {
    "url": "https://github.com/MoFeng-02/LingFan.Engine/issues"
  },
  "keywords": [
    "narrative",
    "build",
    "story-compiler",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
