<?xml version="1.0" encoding="utf-8"?>
<!-- 大媒体回环供给的明文放行：加密音视频在 Android 上经 lfstream 供给不可行
     （拦截层对非零起点 Range 必失败；且 Tauri 协议响应体在 Android 侧整段拷进 JVM byte[]，
     设备 Java 堆放不下大媒体），故改由本机 127.0.0.1 上的回环 HTTP 服务按需分块解密供给。
     应用清单元数据 usesCleartextTraffic=false（API 24+ 默认拒绝明文），此处只对回环域放行：
     暴露面是一个仅本机可达的随机端口 + 路径随机 token，不涉及任何外部域。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
