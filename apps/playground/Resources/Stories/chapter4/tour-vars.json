            },
            {
              "text": "声光餐车",
              "target": "tour_av"
            },
            {
              "text": "舞台窗口",
              "target": "tour_stage"
            },
            {
              "text": "扩展工坊",
              "target": "tour_ext"
            },
            {
              "text": "守卫工坊",
              "target": "tour_guard"
