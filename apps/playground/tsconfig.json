{
  /* playground 的宿主源码项目。
     `src/Stories.src/**` 不归本工程：故事源是独立的 TS 工程，由 tsconfig.stories.json
     的纯 tsc 检查。本工程由 vue-tsc 承担 SFC 类型，会把故事源 import 的 `*.vue`
     解析成真实组件、盖过 authoring 声明的 UiHandle 通配，把 mount(句柄) 判成型不匹配。 */
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/Stories.src/**"]
}
