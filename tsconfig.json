{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "skipLibCheck": true,

    /* 类型边界：workspace 包经 exports 指向 TS 源码（source-exports，零构建步骤）；
       本仓只用无扩展名相对导入，模块后缀求解让 tsc 与 tsx 取同一套决议
       （否则 tsc 找不到 "../cell" 这类目录索引） */
    "moduleSuffixes": [".ts", ""],
    "types": ["vite/client"],
    "paths": {
      "@lingfan/stories-build": ["./packages/stories-build/src/index.ts"],
      "@lingfan/stories-build/cell": ["./packages/stories-build/src/cell/index.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.vue",
    "apps/*/*.ts",
    "template/**/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
