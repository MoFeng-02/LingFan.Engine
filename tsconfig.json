{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "skipLibCheck": true,

    /* 类型边界：workspace 包经 exports 指向 TS 源码（source-exports，零构建步骤）；
       仓库内相对导入一律完整指定（.ts 后缀或 /index.ts 目录索引）——tsc、tsx、vite
       与 Node 原生 ESM 对同一说明符取同一套决议，包源码不经构建即可原生加载 */
    "types": ["vite/client"],
    "paths": {
      "@lingfan-engine/shell": ["./packages/shell/src/index.ts"],
      "@lingfan-engine/stories-build": [
        "./packages/stories-build/src/index.ts"
      ],
      "@lingfan-engine/stories-build/cell": [
        "./packages/stories-build/src/cell/index.ts"
      ]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.vue",
    "apps/*/pages/**/*.ts",
    "apps/*/*.ts",
    "template/**/src/**/*.ts",
    "tests/**/*.ts"
  ],
  /* 叠加层是生成器的事实素材，不是本仓源码：它们各自带 tsconfig、依赖别的框架
     （vue / react / @vitejs/plugin-*），本仓没装那些包，纳入检查只会得到必然的解析失败 */
  "exclude": ["template/*/overlays/**"]
}
